# Copy to .env (never commit .env).
ANTHROPIC_API_KEY=
OPENFDA_API_KEY=              # optional; higher rate limit
PILLWISE_MOCK=1               # 1 = canned results (UI works with no backend); 0 = real pipeline
PILLWISE_OFFLINE=0            # 1 = RxNorm/openFDA from data/cache only (use on stage)
PILLWISE_MODEL_MAIN=claude-sonnet-5-5
PILLWISE_MODEL_FAST=claude-haiku-5-5
# PILLWISE_DDINTER_DB=data/ddinter.sqlite
# PILLWISE_AUDIT_DB=data/audit.sqlite
